#!/bin/bash

#
# This script is run before systemd shuts down the debix
# it is used for safety mechanisms and has 90 seconds to complete before systemd kills it
#

# Reset all motor/servo values to a safe state
/home/debix/ase/bin/rover-reset
# Show powered off logo
/home/debix/ase/bin/rover-logo logo_powered_off 
# beep shutdown || /home/debix/ase/bin/beep shutdown