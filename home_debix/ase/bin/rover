ROVER_TARGET_PATH = SERVICE_DIR + ROVER_TARGET
ROVER_TARGET_TEMPLATE = """
[Unit]
Description=ASE rover utility group
Documentation=https://docs.ase.vu.nl
Wants=%s


[Install]
WantedBy=multi-user.target
"""





