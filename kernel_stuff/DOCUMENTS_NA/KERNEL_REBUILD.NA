	EXT_GPIO0       -> CAN1_TXD   = AD16  = gpio3.IO[22] = (3 - 1)*32 + 22 = 86
	EXT_GPIO1       -> CAN1_RXD   = AF16  = gpio3.IO[23] = (3 - 1)*32 + 23 = 87
	EXT_GPIO2       -> CAN2_TXD   = AE14  = gpio3.IO[24] = (3 - 1)*32 + 24 = 88
	EXT_GPIO3       -> CAN2_RXD   = AF14  = gpio3.IO[25] = (3 - 1)*32 + 25 = 89
	LED1_GPIO       -> GPIO1_IO03 = D6    = gpio1.IO[3]  = (1 - 1)*32 + 13 = 3
	LED2_GPIO       -> GPIO1_IO04 = E6    = gpio1.IO[4]  =                 = 4
	SW1_GPIO_TOGGLE -> GPIO1_IO12 = A5    = gpio1.IO[12] =                 = 12
	SW2_GPIO_PUSH   -> GPIO1_IO13 = A6    = gpio1.IO[13] =                 = 13
	
	If more GPIO is needed, either SPI block can be disabled in the devicetree.
	SPI1_SS0_DBX    -> ECSPI1_SS0  = AE20 = gpio5.IO[9]  = (5 - 1)*32 + 9  = 137
	SPI1_MOSI_DBX   -> ECSPI1_MOSI = AC20 = gpio5.IO[7]  =                 = 135
	SPI1_MISO_DBX   -> ECSPI1_MISO = AD20 = gpio5.IO[8]  =                 = 136
	SPI1_SCLK_DBX   -> ECSPI1_SCLK = AF20 = gpio5.IO[6]  =                 = 134
	SPI1_SS0_DBX    -> ECSPI2_SS0  = AJ22 = gpio5.IO[13] =                 = 141
	SPI1_MOSI_DBX   -> ECSPI2_MOSI = AJ21 = gpio5.IO[11] =                 = 139
	SPI1_MISO_DBX   -> ECSPI2_MISO = AH20 = gpio5.IO[12] =                 = 140
	SPI1_SCLK_DBX   -> ECSPI2_SCLK = AH21 = gpio5.IO[10] =                 = 138
	

